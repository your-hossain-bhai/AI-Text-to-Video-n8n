      "parameters": {
        "jsCode": "const audio = $input.first();\nconst shotstack = $('Get Upload URL').first().json;\n\nreturn [\n  {\n    json: {\n      uploadUrl: shotstack.data.attributes.url,\n      sourceId: shotstack.data.id\n    },\n    binary: audio.binary\n  }\n];"
