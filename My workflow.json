        },
        "messages": {
          "values": [
            {
              "content": "=You are a short-form video content writer.\n\nCreate content for this topic:\n\n{{ $('Edit Fields').item.json.topic }}\n\nReturn ONLY valid JSON in exactly this format:\n\n{\n  \"hook\": \"A short attention-grabbing opening sentence\",\n  \"script\": \"A 20-30 second narration script\",\n  \"caption\": \"A short social media caption\",\n  \"hashtags\": \"#hashtag1 #hashtag2 #hashtag3 #hashtag4 #hashtag5\"\n}\n\nMake the hook curiosity-driven.\nMake the script natural and easy to narrate.\nDo not use emojis.\nDo not use markdown."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "923dc4db-b54f-4665-8b48-a0c4419d60b9",
      "name": "Message a model",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        -48,
        -160
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "0a0GlPCIChUR9k2B",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.content.parts[0].text;\n\nconst data = JSON.parse(raw);\n\nreturn [\n  {\n    json: {\n      hook: data.hook,\n      script: data.script,\n      caption: data.caption,\n      hashtags: data.hashtags\n    }\n  }\n];"
      },
