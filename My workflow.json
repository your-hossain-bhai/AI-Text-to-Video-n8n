    {
      "parameters": {
        "jsCode": "const videos = $input.first().json.videos;\n\nif (!videos || videos.length === 0) {\n  throw new Error(\"No videos found\");\n}\n\nfor (const video of videos) {\n  const files = video.video_files || [];\n\n  const suitable = files\n    .filter(file => file.width && file.height)\n    .filter(file => file.height >= file.width)\n    .sort((a, b) => {\n      const aDiff = Math.abs(a.width - 720);\n      const bDiff = Math.abs(b.width - 720);\n      return aDiff - bDiff;\n    });\n\n  if (suitable.length > 0) {\n    return [{\n      json: {\n        video_id: video.id,\n        duration: video.duration,\n        video_url: suitable[0].link,\n        width: suitable[0].width,\n        height: suitable[0].height\n      }\n    }];\n  }\n}\n\nthrow new Error(\"No suitable vertical video found\");"
      },
